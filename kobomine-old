<script>
// ── PAGE ROUTER ──
function showPage(id) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  window.scrollTo(0, 0);
}

// ── ONBOARDING STEPS (show/hide with Tailwind hidden class) ──
let obStep = 0;
const totalSteps = 4;

function updateObUI() {
  document.querySelectorAll('.ob-step').forEach((s, i) => {
    s.classList.toggle('hidden', i !== obStep);
    if (i === obStep) s.classList.add('animate-fadeup');
  });
  for (let i = 0; i < totalSteps; i++) {
    const dot = document.getElementById('ob-dot-' + i);
    dot.style.background = i < obStep ? '#0B3D2E' : i === obStep ? '#1A7A5C' : '#C8EDDA';
  }
  document.getElementById('ob-step-label').textContent = `Step ${obStep + 1} of ${totalSteps}`;
  const backBtn = document.getElementById('ob-back');
  backBtn.classList.toggle('hidden', obStep === 0);
  document.getElementById('ob-next').textContent = obStep === totalSteps - 1 ? 'Go to my dashboard →' : 'Continue →';
}

function obNext() {
  if (obStep === 0) {
    const income = document.getElementById('ob-income').value;
    if (income) document.getElementById('ob-income-display').textContent = '₦' + parseInt(income).toLocaleString();
  }
  if (obStep < totalSteps - 1) { obStep++; updateObUI(); }
  else showPage('page-dashboard');
}

function obBack() {
  if (obStep > 0) { obStep--; updateObUI(); }
}

// ── TOGGLE SWITCH helper (knob position) ──
document.addEventListener('click', e => {
  const btn = e.target.closest('.toggle-btn');
  if (!btn) return;
  const knob = btn.querySelector('.toggle-knob');
  if (!knob) return;
  knob.style.left = btn.classList.contains('on') ? '22px' : '2px';
});

// ── AUTH ──
function togglePw(inputId, btn) {
  const input = document.getElementById(inputId);
  input.type = input.type === 'password' ? 'text' : 'password';
  btn.textContent = input.type === 'password' ? 'Show' : 'Hide';
}

function handleLogin() {
  const email = document.getElementById('login-email');
  const pw    = document.getElementById('login-pw');
  let ok = true;
  document.getElementById('login-email-err').textContent = '';
  document.getElementById('login-pw-err').textContent = '';
  if (!email.value.includes('@')) {
    document.getElementById('login-email-err').textContent = 'Please enter a valid email address.';
    email.style.borderColor = '#C0392B'; ok = false;
  } else { email.style.borderColor = ''; }
  if (pw.value.length < 6) {
    document.getElementById('login-pw-err').textContent = 'Password must be at least 6 characters.';
    pw.style.borderColor = '#C0392B'; ok = false;
  } else { pw.style.borderColor = ''; }
  if (ok) showPage('page-dashboard');
}

function handleRegister() {
  const first = document.getElementById('reg-first');
  const email = document.getElementById('reg-email');
  const pw    = document.getElementById('reg-pw');
  let ok = true;
  ['reg-first-err','reg-email-err','reg-pw-err'].forEach(id => document.getElementById(id).textContent = '');
  if (!first.value.trim()) { document.getElementById('reg-first-err').textContent = 'Please enter your first name.'; ok = false; }
  if (!email.value.includes('@')) { document.getElementById('reg-email-err').textContent = 'Please enter a valid email.'; ok = false; }
  if (pw.value.length < 8) { document.getElementById('reg-pw-err').textContent = 'Password must be at least 8 characters.'; ok = false; }
  if (ok) {
    document.getElementById('ob-user-name').textContent = first.value.trim();
    const income = document.getElementById('reg-income').value;
    if (income) document.getElementById('ob-income-display').textContent = '₦' + parseInt(income).toLocaleString();
    showPage('page-onboarding');
  }
}

// ── CONTROL OPTION toggle (onboarding step 3) ──
function toggleControlOption(el) {
  const isOn = el.style.borderColor === 'rgb(11, 61, 46)' || el.classList.contains('border-brand');
  el.style.borderColor = isOn ? '' : '#0B3D2E';
  el.style.background  = isOn ? '' : 'rgba(11,61,46,0.04)';
}

// ── DATE ──
const now = new Date();
const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const el = document.getElementById('dash-date');
if (el) {
  const daysInMonth = new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate();
  el.textContent = `${months[now.getMonth()]} ${now.getFullYear()} · Day ${now.getDate()} of ${daysInMonth}`;
}
</script>
